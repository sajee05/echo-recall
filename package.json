{
  "name": "echo-recall",
  "version": "3.0.1",
  "description": "Active-recall revision with spaced repetition and Anki export for Obsidian.",
  "main": "main.js",
  "scripts": {
    "build": "esbuild main.ts --bundle --external:obsidian --outfile=main.js --format=cjs --target=es2018",
    "dev": "esbuild main.ts --bundle --external:obsidian --outfile=main.js --format=cjs --target=es2018 --watch"
  },
  "keywords": ["spaced repetition", "active recall", "anki"],
  "author": "sxjeel",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "esbuild": "^0.28.1",
    "obsidian": "^1.13.1"
  }
}
